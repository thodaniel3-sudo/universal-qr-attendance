# Frontend (Vite) — SAFE TO EXPOSE. Never add secrets with the VITE_ prefix.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY
VITE_PLATFORM_NAME=Attendance Platform
VITE_APP_URL=http://localhost:5173

# Server-side only (put these in .env.local for functions, never in VITE_)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_ANON_KEY=YOUR_ANON_KEY
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=no-reply@yourdomain.com
CRON_SECRET=generate-a-long-random-string
SIGNED_URL_TTL_SECONDS=300
PLATFORM_ADMIN_SESSION_TIMEOUT_MINUTES=30
GRACE_PERIOD_DAYS=90